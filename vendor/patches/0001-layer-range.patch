diff --git a/examples/layer-range/layer-range.cpp b/examples/layer-range/layer-range.cpp
new file mode 100644
index 0000000..f6efe09
--- /dev/null
+++ b/examples/layer-range/layer-range.cpp
@@ -0,0 +1,293 @@
+// test for the layer range (pipeline stage) mode of llama_model_params:
+// runs a model monolithically and as a 3-stage pipeline [0,a) -> [a,b) -> [b,n_layer) and compares the logits
+//
+// usage: llama-layer-range <model.gguf> <split_a> <split_b> [n_gpu_layers]
+
+#include "llama.h"
+
+#include <algorithm>
+#include <clocale>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+struct stage {
+    llama_model   * model = nullptr;
+    llama_context * ctx   = nullptr;
+};
+
+static llama_model * load_model(const char * path, int32_t il_begin, int32_t il_end, int32_t ngl) {
+    llama_model_params mparams = llama_model_default_params();
+    mparams.n_gpu_layers = ngl;
+    mparams.layer_begin  = il_begin;
+    mparams.layer_end    = il_end;
+
+    llama_model * model = llama_model_load_from_file(path, mparams);
+    if (model == nullptr) {
+        fprintf(stderr, "error: failed to load the model with layers [%d, %d)\n", il_begin, il_end);
+        exit(1);
+    }
+    return model;
+}
+
+static llama_context * make_ctx(llama_model * model, bool embeddings) {
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx           = 128;
+    cparams.n_batch         = 128;
+    cparams.n_ubatch        = 128;
+    cparams.n_seq_max       = 2;
+    cparams.n_threads       = 4;
+    cparams.n_threads_batch = 4;
+    cparams.embeddings      = embeddings;
+    if (embeddings) {
+        cparams.pooling_type = LLAMA_POOLING_TYPE_NONE;
+    }
+
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    if (ctx == nullptr) {
+        fprintf(stderr, "error: failed to create a context\n");
+        exit(1);
+    }
+    return ctx;
+}
+
+// decode either tokens or embeddings (n_embd floats per token) at positions [pos0, pos0 + n), output all
+static void decode(llama_context * ctx, const llama_token * tokens, const float * embd, int32_t n, int32_t n_embd, llama_pos pos0, llama_seq_id seq = 0) {
+    llama_batch batch = llama_batch_init(n, embd ? n_embd : 0, 1);
+    batch.n_tokens = n;
+    for (int32_t i = 0; i < n; ++i) {
+        if (embd) {
+            memcpy(batch.embd + (size_t) i*n_embd, embd + (size_t) i*n_embd, n_embd*sizeof(float));
+        } else {
+            batch.token[i] = tokens[i];
+        }
+        batch.pos[i]       = pos0 + i;
+        batch.n_seq_id[i]  = 1;
+        batch.seq_id[i][0] = seq;
+        batch.logits[i]    = 1;
+    }
+    const int ret = llama_decode(ctx, batch);
+    llama_batch_free(batch);
+    if (ret != 0) {
+        fprintf(stderr, "error: llama_decode failed, ret = %d\n", ret);
+        exit(1);
+    }
+}
+
+static std::vector<float> get_rows(llama_context * ctx, bool logits, int32_t n, int32_t width) {
+    std::vector<float> out((size_t) n*width);
+    for (int32_t i = 0; i < n; ++i) {
+        const float * row = logits ? llama_get_logits_ith(ctx, i) : llama_get_embeddings_ith(ctx, i);
+        if (row == nullptr) {
+            fprintf(stderr, "error: no %s for output %d\n", logits ? "logits" : "embeddings", i);
+            exit(1);
+        }
+        memcpy(out.data() + (size_t) i*width, row, width*sizeof(float));
+    }
+    return out;
+}
+
+// head -> middle -> tail, returns the logits of the tail
+static std::vector<float> run_pipeline(stage * st, const llama_token * tokens, int32_t n, int32_t n_embd, int32_t n_vocab, llama_pos pos0, llama_seq_id seq = 0) {
+    decode(st[0].ctx, tokens, nullptr, n, n_embd, pos0, seq);
+    const std::vector<float> h0 = get_rows(st[0].ctx, false, n, n_embd);
+
+    decode(st[1].ctx, nullptr, h0.data(), n, n_embd, pos0, seq);
+    const std::vector<float> h1 = get_rows(st[1].ctx, false, n, n_embd);
+
+    decode(st[2].ctx, nullptr, h1.data(), n, n_embd, pos0, seq);
+    return get_rows(st[2].ctx, true, n, n_vocab);
+}
+
+static int argmax(const float * v, int32_t n) {
+    return (int) (std::max_element(v, v + n) - v);
+}
+
+// compare two [n x n_vocab] logits matrices, returns true on pass
+static bool compare(const char * name, const std::vector<float> & ref, const std::vector<float> & got, int32_t n, int32_t n_vocab) {
+    double max_diff = 0.0;
+    double sum_diff = 0.0;
+    for (size_t i = 0; i < ref.size(); ++i) {
+        const double d = std::fabs((double) ref[i] - (double) got[i]);
+        max_diff = std::max(max_diff, d);
+        sum_diff += d;
+    }
+    int n_argmax_eq = 0;
+    for (int32_t i = 0; i < n; ++i) {
+        n_argmax_eq += argmax(ref.data() + (size_t) i*n_vocab, n_vocab) == argmax(got.data() + (size_t) i*n_vocab, n_vocab);
+    }
+    const bool ok = max_diff < 1e-3 && n_argmax_eq == n;
+    printf("%-24s max abs diff = %.3e, mean abs diff = %.3e, argmax equal = %d/%d -> %s\n",
+            name, max_diff, sum_diff/ref.size(), n_argmax_eq, n, ok ? "PASS" : "FAIL");
+    return ok;
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    if (argc < 4) {
+        fprintf(stderr, "usage: %s <model.gguf> <split_a> <split_b> [n_gpu_layers]\n", argv[0]);
+        return 1;
+    }
+
+    const char * path = argv[1];
+    const int32_t a   = atoi(argv[2]);
+    const int32_t b   = atoi(argv[3]);
+    const int32_t ngl = argc > 4 ? atoi(argv[4]) : 0;
+
+    llama_backend_init();
+    llama_log_set([](ggml_log_level level, const char * text, void *) {
+        if (level >= GGML_LOG_LEVEL_WARN) {
+            fputs(text, stderr);
+        }
+    }, nullptr);
+
+    // a. monolithic reference
+    llama_model * full = load_model(path, 0, -1, ngl);
+    const int32_t n_layer = llama_model_n_layer(full);
+    const int32_t n_embd  = llama_model_n_embd(full);
+    const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(full));
+
+    if (!(0 < a && a < b && b < n_layer)) {
+        fprintf(stderr, "error: need 0 < split_a < split_b < n_layer (%d)\n", n_layer);
+        return 1;
+    }
+
+    printf("model: n_layer = %d, n_embd = %d, n_vocab = %d, n_gpu_layers = %d\n", n_layer, n_embd, n_vocab, ngl);
+    printf("pipeline: [0,%d) -> [%d,%d) -> [%d,%d)\n", a, a, b, b, n_layer);
+
+    const std::string prompt = "hello world the model network node";
+    const llama_vocab * vocab = llama_model_get_vocab(full);
+    const int32_t n_prompt = -llama_tokenize(vocab, prompt.c_str(), prompt.size(), nullptr, 0, true, true);
+    std::vector<llama_token> tokens(n_prompt);
+    if (llama_tokenize(vocab, prompt.c_str(), prompt.size(), tokens.data(), tokens.size(), true, true) < 0) {
+        fprintf(stderr, "error: failed to tokenize\n");
+        return 1;
+    }
+    printf("prompt: %d tokens\n", n_prompt);
+
+    llama_context * ctx_full = make_ctx(full, false);
+    decode(ctx_full, tokens.data(), nullptr, n_prompt, n_embd, 0);
+    const std::vector<float> ref = get_rows(ctx_full, true, n_prompt, n_vocab);
+
+    // b. the pipeline
+    stage st[3];
+    st[0].model = load_model(path, 0, a, ngl);
+    st[1].model = load_model(path, a, b, ngl);
+    st[2].model = load_model(path, b, -1, ngl);
+    st[0].ctx = make_ctx(st[0].model, true);
+    st[1].ctx = make_ctx(st[1].model, true);
+    st[2].ctx = make_ctx(st[2].model, false);
+
+    for (int i = 0; i < 3; ++i) {
+        printf("stage %d: layers [%d, %d)\n", i, llama_model_layer_begin(st[i].model), llama_model_layer_end(st[i].model));
+    }
+
+    bool ok = true;
+
+    // c. prompt
+    const std::vector<float> got = run_pipeline(st, tokens.data(), n_prompt, n_embd, n_vocab, 0);
+    ok &= compare("prompt:", ref, got, n_prompt, n_vocab);
+
+    // d. incremental decode of one more token through the KV caches
+    const llama_token next = argmax(ref.data() + (size_t) (n_prompt - 1)*n_vocab, n_vocab);
+    printf("next token = %d\n", next);
+
+    decode(ctx_full, &next, nullptr, 1, n_embd, n_prompt);
+    const std::vector<float> ref1 = get_rows(ctx_full, true, 1, n_vocab);
+
+    const std::vector<float> got1 = run_pipeline(st, &next, 1, n_embd, n_vocab, n_prompt);
+    ok &= compare("incremental decode:", ref1, got1, 1, n_vocab);
+
+    // e. seq_rm of the new token on all stages, then decode it again
+    for (int i = 0; i < 3; ++i) {
+        if (!llama_memory_seq_rm(llama_get_memory(st[i].ctx), 0, n_prompt, -1)) {
+            fprintf(stderr, "error: llama_memory_seq_rm failed on stage %d\n", i);
+            return 1;
+        }
+    }
+    const std::vector<float> got2 = run_pipeline(st, &next, 1, n_embd, n_vocab, n_prompt);
+    ok &= compare("after seq_rm:", ref1, got2, 1, n_vocab);
+
+    // e2. seq_cp of seq 0 to seq 1 (whole sequence, as required by per-seq streams), keep the prompt only,
+    //     then decode the next token in seq 1 (monolithic and pipeline)
+    {
+        llama_memory_seq_cp(llama_get_memory(ctx_full), 0, 1, 0, -1);
+        llama_memory_seq_rm(llama_get_memory(ctx_full), 1, n_prompt, -1);
+        for (int i = 0; i < 3; ++i) {
+            llama_memory_seq_cp(llama_get_memory(st[i].ctx), 0, 1, 0, -1);
+            llama_memory_seq_rm(llama_get_memory(st[i].ctx), 1, n_prompt, -1);
+        }
+        decode(ctx_full, &next, nullptr, 1, n_embd, n_prompt, 1);
+        const std::vector<float> ref3 = get_rows(ctx_full, true, 1, n_vocab);
+        const std::vector<float> got3 = run_pipeline(st, &next, 1, n_embd, n_vocab, n_prompt, 1);
+        ok &= compare("after seq_cp:", ref3, got3, 1, n_vocab);
+    }
+
+    // e3. seq_add: shift seq 1 by +3 positions (K-shift on every stage), then decode the next token after the gap
+    {
+        const llama_pos shift = 3;
+        llama_memory_seq_rm (llama_get_memory(ctx_full), 1, n_prompt, -1);
+        llama_memory_seq_add(llama_get_memory(ctx_full), 1, 0, -1, shift);
+        for (int i = 0; i < 3; ++i) {
+            llama_memory_seq_rm (llama_get_memory(st[i].ctx), 1, n_prompt, -1);
+            llama_memory_seq_add(llama_get_memory(st[i].ctx), 1, 0, -1, shift);
+        }
+        decode(ctx_full, &next, nullptr, 1, n_embd, n_prompt + shift, 1);
+        const std::vector<float> ref4 = get_rows(ctx_full, true, 1, n_vocab);
+        const std::vector<float> got4 = run_pipeline(st, &next, 1, n_embd, n_vocab, n_prompt + shift, 1);
+        ok &= compare("after seq_add:", ref4, got4, 1, n_vocab);
+    }
+
+    // the KV cache of a stage only holds its own layers (seq 0 holds the same tokens on every context here)
+    printf("seq 0 state size: full = %zu bytes", llama_state_seq_get_size(ctx_full, 0));
+    for (int i = 0; i < 3; ++i) {
+        printf(", stage %d = %zu bytes", i, llama_state_seq_get_size(st[i].ctx, 0));
+    }
+    printf("\n");
+
+    // negative control: skipping the middle stage must change the logits (the stages really compute their layers)
+    {
+        for (int i = 0; i < 3; ++i) {
+            llama_memory_clear(llama_get_memory(st[i].ctx), true);
+        }
+        decode(st[0].ctx, tokens.data(), nullptr, n_prompt, n_embd, 0);
+        const std::vector<float> h0 = get_rows(st[0].ctx, false, n_prompt, n_embd);
+        decode(st[2].ctx, nullptr, h0.data(), n_prompt, n_embd, 0);
+        const std::vector<float> bad = get_rows(st[2].ctx, true, n_prompt, n_vocab);
+        double max_diff = 0.0;
+        for (size_t i = 0; i < ref.size(); ++i) {
+            max_diff = std::max(max_diff, std::fabs((double) ref[i] - (double) bad[i]));
+        }
+        const bool ctrl_ok = max_diff > 1e-3;
+        printf("%-24s max abs diff = %.3e (expected large) -> %s\n", "control (no middle):", max_diff, ctrl_ok ? "PASS" : "FAIL");
+        ok &= ctrl_ok;
+    }
+
+    // f. memory
+    printf("model size: full = %llu bytes", (unsigned long long) llama_model_size(full));
+    for (int i = 0; i < 3; ++i) {
+        printf(", stage %d = %llu bytes", i, (unsigned long long) llama_model_size(st[i].model));
+    }
+    printf("\n");
+    printf("model params: full = %llu", (unsigned long long) llama_model_n_params(full));
+    for (int i = 0; i < 3; ++i) {
+        printf(", stage %d = %llu", i, (unsigned long long) llama_model_n_params(st[i].model));
+    }
+    printf("\n");
+
+    for (int i = 0; i < 3; ++i) {
+        llama_free(st[i].ctx);
+        llama_model_free(st[i].model);
+    }
+    llama_free(ctx_full);
+    llama_model_free(full);
+    llama_backend_free();
+
+    printf("%s\n", ok ? "ALL PASS" : "FAILED");
+
+    return ok ? 0 : 1;
+}
